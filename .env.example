# Copiar a .env (que NO se sube al repositorio, ver .gitignore) y completar.
#
# JWT_SECRET es OPCIONAL en desarrollo: si no lo definís, el servidor genera un
# secreto aleatorio en cada arranque (las sesiones no sobreviven a un reinicio).
# En PRODUCCIÓN es obligatorio que sea estable, largo y secreto.
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria

# Opcionales: estos son los valores por defecto para desarrollo local.
# La base de desarrollo no usa contraseña y solo escucha en 127.0.0.1.
# DATABASE_URL=postgres://transi@localhost:5432/transi?sslmode=disable
# PORT=8080
