# Copiar a `.env` y completar. NO se sube al repositorio.
#
#   cp .env.example .env
#
# El acceso con EMAIL funciona sin configurar nada: crea un perfil local en el
# dispositivo. Estas variables son solo para habilitar Google, Apple o Facebook.
# La app funciona completa sin ellas y tus registros nunca se envían.

# ── Google ────────────────────────────────────────────────────────────
# Console de Google → APIs y servicios → Credenciales → ID de cliente OAuth
# tipo "Aplicación web". Orígenes autorizados:
#   http://localhost:5173              (desarrollo)
#   https://paolobastida.github.io     (demo publicada)
VITE_GOOGLE_CLIENT_ID=

# ── Apple (Sign in with Apple) ────────────────────────────────────────
# developer.apple.com → Certificates, Identifiers & Profiles → Identifiers →
# Services IDs → "Sign In with Apple". El Service ID es el CLIENT_ID.
# En "Return URLs" hay que declarar el REDIRECT_URI.
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=

# ── Facebook (Login de Facebook) ──────────────────────────────────────
# developers.facebook.com → Mi app → Configuración → Básica → ID de aplicación.
# Los orígenes se declaran en "Dominios permitidos para el SDK de JavaScript".
VITE_FACEBOOK_APP_ID=
