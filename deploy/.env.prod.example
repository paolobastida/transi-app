# Copiar a `.env` en la raíz del proyecto (NO se sube al repositorio) y
# completar con valores reales antes de levantar docker-compose.prod.yml.

# Dominio público con HTTPS (debe apuntar al VPS).
DOMINIO=transi.tudominio.com

# Base de datos de producción.
POSTGRES_USER=transi
POSTGRES_PASSWORD=cambiar-por-una-clave-larga-y-unica
POSTGRES_DB=transi

# Clave para firmar los tokens. Larga, secreta y estable.
JWT_SECRET=cambiar-por-otra-clave-larga-y-secreta

# Orígenes permitidos para CORS (la app web). En móvil no aplica.
CORS_ORIGENES=https://transi.tudominio.com

# IP o redes (CIDR) de confianza para leer X-Forwarded-For (el límite de
# intentos). Debe incluir la red interna de Docker, que es de donde Caddy
# conecta a la API. Caddy agrega la IP real del cliente al final de la cadena,
# así que el límite no se puede saltar falseando el header.
PROXIES_CONFIABLES=172.16.0.0/12
